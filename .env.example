POSTGRES_DB=face_attendance
POSTGRES_USER=face_user
POSTGRES_PASSWORD=face_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://face_user:face_password@localhost:5432/face_attendance

CAMERA_INDEX=0
FACE_SIMILARITY_THRESHOLD=0.50
TIMEZONE=Asia/Ho_Chi_Minh

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

LIVENESS_TIMEOUT_SECONDS=15
LIVENESS_BLINK_EAR_THRESHOLD=0.20
LIVENESS_HEAD_TURN_RATIO=0.38
LIVENESS_REQUIRED_FRAMES=3
LIVENESS_PROOF_TTL_SECONDS=10
RECOGNITION_SESSION_TIMEOUT_SECONDS=30
RECOGNITION_HOLD_SECONDS=1
RECOGNITION_MAX_FRAME_GAP_SECONDS=1
MIN_CHECKOUT_MINUTES=60
MIN_PUNCH_INTERVAL_SECONDS=60
OVERTIME_MIN_MINUTES=30
HALF_DAY_RATIO=0.75
FACE_ENGINE_WARMUP=true
IMAGE_PREPROCESS_ENABLED=true
IMAGE_CLAHE_CLIP_LIMIT=2.0
IMAGE_CLAHE_TILE_GRID=8
IMAGE_TARGET_BRIGHTNESS=125
IMAGE_BRIGHTNESS_TOLERANCE=25
ENROLLMENT_SESSION_TIMEOUT_SECONDS=180
ENROLLMENT_CAPTURE_INTERVAL_MS=500
MAX_FRAME_BYTES=5242880
WORKER_HEARTBEAT_TIMEOUT_SECONDS=10
WORKER_STATUS_FILE=runtime/worker-status.json
# Email thông báo duyệt nghỉ phép. Để trống SMTP_HOST để tắt gửi email.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD là App Password
# (Google Account > Security > App passwords), không phải mật khẩu đăng nhập.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=Phòng Hành chính - Nhân sự
COMPANY_NAME=Công ty Acacy
HR_CONTACT_EMAIL=
HR_CONTACT_PHONE=
DEBUG=false
LOG_LEVEL=INFO
# false: frame HTTP access logs are hidden at INFO to avoid flooding the console.
LOG_HTTP_FRAME_REQUESTS=false
